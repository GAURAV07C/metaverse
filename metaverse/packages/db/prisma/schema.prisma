// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @unique @default(cuid())
  username String  @unique
  password String  
  avatarId String?
  role     Role

  orgId    String?
  org      Organization? @relation(fields: [orgId], references: [id])
  teamId   String?
  team     Team? @relation(fields: [teamId], references: [id])

  spaces Space[]
  avatar Avatar? @relation(fields: [avatarId] , references: [id])
}

model Space {
  id        String  @id @unique @default(cuid())
  name      String
  width     Int
  height    Int?
  thumbnail String?
  creatorId String
  admin User @relation(fields: [creatorId], references: [id])
  elements spaceElements[]
  privateZones PrivateZone[]
  meetings     Meeting[]
}

model spaceElements {
  id        String @id @unique @default(cuid())
  elementId String
  spaceId   String
  x         Int
  y         Int

  space Space @relation(fields: [spaceId], references: [id])
  element Element @relation(fields: [elementId], references: [id])
}

model Element {
  id       String @id @unique @default(cuid())
  width    Int
  height   Int
  static Boolean
  imageUrl String
  space spaceElements[]
  maps MapElements[]
  interactiveObjects InteractiveObject[]
}

model Map {
  id     String  @id @unique @default(cuid())
  width  Int
  height Int
  name   String
  thumbnails String
  mapElements MapElements[]
}

model MapElements {
  id        String  @id @unique @default(cuid())
  mapId     String
  elementId String
  x         Int?
  y         Int?
  map Map @relation(fields: [mapId], references: [id])
  element Element @relation(fields: [elementId], references: [id])
}

model Avatar {
  id       String  @id @unique @default(cuid())
  imageUrl String?
  name     String?
  users User[]
}

enum Role {
  Admin
  User
}

model Organization {
  id      String   @id @default(cuid())
  name    String
  logo    String?
  teams   Team[]
  users   User[]
}

model Team {
  id      String   @id @default(cuid())
  name    String
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  users   User[]
}

model PrivateZone {
  id      String @id @default(cuid())
  name    String
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])
  startX  Int
  startY  Int
  endX    Int
  endY    Int
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id])
}

model InteractiveObject {
  id        String  @id @default(cuid())
  type      String  // "WHITEBOARD", "SCREENSHARE", "GAME"
  elementId String
  element   Element @relation(fields: [elementId], references: [id])
  state     Json?
}