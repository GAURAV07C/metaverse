// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @unique @default(cuid())
  username String  @unique
  password String  
  avatarId String?
  role     Role

  orgId    String?
  org      Organization? @relation(fields: [orgId], references: [id])
  teamId   String?
  team     Team? @relation(fields: [teamId], references: [id])

  spaces Space[]
  avatar Avatar? @relation(fields: [avatarId] , references: [id])
  assignedDesks DeskAssignment[]
  studioDrafts SpaceDraft[]
  mapVersions SpaceMapVersion[]
  spaceMemberships SpaceMember[] @relation("SpaceMemberUser")
  createdSpaceMemberships SpaceMember[] @relation("SpaceMemberCreator")
  notificationPreferences NotificationPreference[]
  chatMessages ChatMessage[]

  @@index([avatarId])
  @@index([orgId])
  @@index([teamId])
}

model Space {
  id        String  @id @unique @default(cuid())
  name      String
  width     Int
  height    Int?
  thumbnail String?
  creatorId String
  admin User @relation(fields: [creatorId], references: [id])
  elements spaceElements[]
  privateZones PrivateZone[]
  meetings     Meeting[]
  settings     SpaceSettings?
  inviteLinks  InviteLink[]
  members      SpaceMember[]
  deskAssignments DeskAssignment[]
  studioDraft  SpaceDraft?
  smartObjects  SmartObject[]
  roomInviteEvents RoomInviteEvent[]
  moderationAuditEvents ModerationAuditEvent[]
  roomSessionEvents RoomSessionEvent[]
  mapVersions SpaceMapVersion[]
  notificationPreferences NotificationPreference[]
  chatMessages ChatMessage[]

  @@index([creatorId])
}

model spaceElements {
  id        String @id @unique @default(cuid())
  elementId String
  spaceId   String
  x         Int
  y         Int
  rotation  Int?    @default(0)
  color     String?
  customData Json?

  space Space @relation(fields: [spaceId], references: [id])
  element Element @relation(fields: [elementId], references: [id])

  @@index([spaceId])
  @@index([elementId])
  @@index([spaceId, x, y])
}

model Element {
  id       String @id @unique @default(cuid())
  width    Int
  height   Int
  static   Boolean
  imageUrl String
  colorMaskUrl String?
  variants Json?
  name     String?
  category String?
  space    spaceElements[]
  maps     MapElements[]
  interactiveObjects InteractiveObject[]

  @@index([category])
}

model Map {
  id     String  @id @unique @default(cuid())
  width  Int
  height Int
  name   String
  thumbnails String
  type   String  @default("map")
  mapElements MapElements[]
  areas  MapArea[]

  @@index([name])
}

model MapElements {
  id        String  @id @unique @default(cuid())
  mapId     String
  elementId String
  x         Int?
  y         Int?
  rotation  Int?    @default(0)
  color     String?
  map Map @relation(fields: [mapId], references: [id])
  element Element @relation(fields: [elementId], references: [id])

  @@index([mapId])
  @@index([elementId])
}

model MapArea {
  id        String  @id @unique @default(cuid())
  mapId     String
  name      String  @default("Area")
  type      String  @default("public")
  floor     String  @default("#f3f4f6")
  color     String  @default("#3b82f6")
  texture   String  @default("solid")
  x         Int
  y         Int
  w         Int
  h         Int
  map       Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId])
}

model Avatar {
  id       String  @id @unique @default(cuid())
  imageUrl String?
  name     String?
  users User[]
}

enum Role {
  Admin
  User
}

model Organization {
  id      String   @id @default(cuid())
  name    String
  logo    String?
  teams   Team[]
  users   User[]

  @@index([name])
}

model Team {
  id      String   @id @default(cuid())
  name    String
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  users   User[]

  @@index([orgId])
}

model PrivateZone {
  id      String @id @default(cuid())
  name    String
  type    String @default("private")
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])
  startX  Int
  startY  Int
  endX    Int
  endY    Int
  floor   String? @default("#f3f4f6")
  color   String? @default("#3b82f6")
  texture String? @default("solid")
  targetUrl String?
  targetSpaceId String?
  targetRoomId String?
  targetX Int?
  targetY Int?
  isDefaultSpawn Boolean @default(false)

  @@index([spaceId])
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id])

  @@index([spaceId])
  @@index([startTime])
}

model InteractiveObject {
  id        String  @id @default(cuid())
  type      String  // "WHITEBOARD", "SCREENSHARE", "GAME"
  elementId String
  element   Element @relation(fields: [elementId], references: [id])
  state     Json?

  @@index([elementId])
}


model SpaceSettings {
  id        String   @id @default(cuid())
  spaceId   String   @unique
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  layoutType String  @default("Hybrid")
  theme     String   @default("Startup")
  sizeRange String   @default("1-10")
  language  String   @default("English")
  colorMode String   @default("Light")
  ambientAudioVideo Boolean @default(true)
  conversationRange String @default("Short")
  autoLockDesks Boolean @default(true)
  announcementsEnabled Boolean @default(true)
  chatChannelsEnabled Boolean @default(true)
  meetingChatEnabled Boolean @default(true)
  nearbyChatEnabled Boolean @default(true)
  directMessagesEnabled Boolean @default(true)
  companyEmailMembership Boolean @default(false)
  supportAccess Boolean @default(true)
  memberInvitesEnabled Boolean @default(true)
  smartObjectsEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InviteLink {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  token     String   @unique
  role      String   @default("Member")
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([spaceId])
  @@index([token])
}

model SpaceMember {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation("SpaceMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role        String   @default("Member")
  createdById String?
  createdBy   User?    @relation("SpaceMemberCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId, role])
  @@index([createdById])
}

model DeskAssignment {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  label     String
  teamName  String   @default("Team")
  x         Int
  y         Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([userId])
  @@index([spaceId, x, y])
}

model SpaceDraft {
  id          String   @id @default(cuid())
  spaceId     String   @unique
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  data        Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}

model SpaceMapVersion {
  id          String   @id @default(cuid())
  spaceId     String
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  version     Int
  data        Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@unique([spaceId, version])
  @@index([spaceId, createdAt])
  @@index([createdById])
}

model SmartObject {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("CUSTOM")
  config    Json?
  state     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([type])
}

model RoomInviteEvent {
  id           String   @id @default(cuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  inviteId     String?
  direction    String
  status       String
  fromUserId   String?
  fromUsername String?
  toUserId     String?
  toUsername   String?
  roomId       String
  roomName     String
  createdAt    DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([inviteId])
  @@index([fromUserId])
  @@index([toUserId])
}

model ModerationAuditEvent {
  id             String   @id @default(cuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  action         String
  status         String
  actorUserId    String?
  actorUsername  String?
  targetUserId   String?
  targetUsername String?
  createdAt      DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([actorUserId])
  @@index([targetUserId])
}

model RoomSessionEvent {
  id             String   @id @default(cuid())
  spaceId        String
  space          Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  roomId         String?
  roomName       String?
  eventType      String
  userId         String?
  username       String?
  previousRoomId String?
  createdAt      DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([spaceId, roomId, createdAt])
  @@index([userId])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joins        Boolean  @default(true)
  chat         Boolean  @default(true)
  roomInvites  Boolean  @default(true)
  sounds       Boolean  @default(true)
  reconnecting Boolean  @default(true)
  respectFocus Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([spaceId, userId])
  @@index([userId])
}

model ChatMessage {
  id           String   @id @default(cuid())
  spaceId      String
  space        Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  username     String
  message      String
  scope        String   @default("everyone")
  targetUserId String?
  isRing       Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([spaceId, createdAt])
  @@index([targetUserId])
}
