// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String  @id @unique @default(cuid())
  username String  @unique
  password String  
  avatarId String?
  role     Role

  orgId    String?
  org      Organization? @relation(fields: [orgId], references: [id])
  teamId   String?
  team     Team? @relation(fields: [teamId], references: [id])

  spaces Space[]
  avatar Avatar? @relation(fields: [avatarId] , references: [id])
  assignedDesks DeskAssignment[]
  studioDrafts SpaceDraft[]

  @@index([avatarId])
  @@index([orgId])
  @@index([teamId])
}

model Space {
  id        String  @id @unique @default(cuid())
  name      String
  width     Int
  height    Int?
  thumbnail String?
  creatorId String
  admin User @relation(fields: [creatorId], references: [id])
  elements spaceElements[]
  privateZones PrivateZone[]
  meetings     Meeting[]
  settings     SpaceSettings?
  inviteLinks  InviteLink[]
  deskAssignments DeskAssignment[]
  studioDraft  SpaceDraft?
  smartObjects  SmartObject[]

  @@index([creatorId])
}

model spaceElements {
  id        String @id @unique @default(cuid())
  elementId String
  spaceId   String
  x         Int
  y         Int
  customData Json?

  space Space @relation(fields: [spaceId], references: [id])
  element Element @relation(fields: [elementId], references: [id])

  @@index([spaceId])
  @@index([elementId])
  @@index([spaceId, x, y])
}

model Element {
  id       String @id @unique @default(cuid())
  width    Int
  height   Int
  static   Boolean
  imageUrl String
  colorMaskUrl String?
  name     String?
  category String?
  space    spaceElements[]
  maps     MapElements[]
  interactiveObjects InteractiveObject[]

  @@index([category])
}

model Map {
  id     String  @id @unique @default(cuid())
  width  Int
  height Int
  name   String
  thumbnails String
  type   String  @default("map")
  mapElements MapElements[]

  @@index([name])
}

model MapElements {
  id        String  @id @unique @default(cuid())
  mapId     String
  elementId String
  x         Int?
  y         Int?
  map Map @relation(fields: [mapId], references: [id])
  element Element @relation(fields: [elementId], references: [id])

  @@index([mapId])
  @@index([elementId])
}

model Avatar {
  id       String  @id @unique @default(cuid())
  imageUrl String?
  name     String?
  users User[]
}

enum Role {
  Admin
  User
}

model Organization {
  id      String   @id @default(cuid())
  name    String
  logo    String?
  teams   Team[]
  users   User[]

  @@index([name])
}

model Team {
  id      String   @id @default(cuid())
  name    String
  orgId   String
  org     Organization @relation(fields: [orgId], references: [id])
  users   User[]

  @@index([orgId])
}

model PrivateZone {
  id      String @id @default(cuid())
  name    String
  spaceId String
  space   Space  @relation(fields: [spaceId], references: [id])
  startX  Int
  startY  Int
  endX    Int
  endY    Int

  @@index([spaceId])
}

model Meeting {
  id        String   @id @default(cuid())
  title     String
  startTime DateTime
  endTime   DateTime
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id])

  @@index([spaceId])
  @@index([startTime])
}

model InteractiveObject {
  id        String  @id @default(cuid())
  type      String  // "WHITEBOARD", "SCREENSHARE", "GAME"
  elementId String
  element   Element @relation(fields: [elementId], references: [id])
  state     Json?

  @@index([elementId])
}


model SpaceSettings {
  id        String   @id @default(cuid())
  spaceId   String   @unique
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  layoutType String  @default("Hybrid")
  theme     String   @default("Startup")
  sizeRange String   @default("1-10")
  language  String   @default("English")
  colorMode String   @default("Light")
  ambientAudioVideo Boolean @default(true)
  conversationRange String @default("Short")
  autoLockDesks Boolean @default(true)
  announcementsEnabled Boolean @default(true)
  chatChannelsEnabled Boolean @default(true)
  meetingChatEnabled Boolean @default(true)
  nearbyChatEnabled Boolean @default(true)
  directMessagesEnabled Boolean @default(true)
  companyEmailMembership Boolean @default(false)
  supportAccess Boolean @default(true)
  memberInvitesEnabled Boolean @default(true)
  smartObjectsEnabled Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InviteLink {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  token     String   @unique
  role      String   @default("Member")
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([spaceId])
  @@index([token])
}

model DeskAssignment {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  label     String
  teamName  String   @default("Team")
  x         Int
  y         Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([userId])
  @@index([spaceId, x, y])
}

model SpaceDraft {
  id          String   @id @default(cuid())
  spaceId     String   @unique
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  data        Json
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}

model SmartObject {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("CUSTOM")
  config    Json?
  state     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spaceId])
  @@index([type])
}
