# Database
DATABASE_URL="postgresql://metaverse:metaverse@localhost:5432/metaverse?schema=public"

# HTTP Service (runs on port 3000 locally, Render assigns PORT automatically)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_PASSWORD="replace-with-a-long-random-secret"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# WebSocket Service (runs on port 3001 locally, Render assigns PORT automatically)
# Optional multi-instance signaling. Upstash Redis TLS URL works here, for example rediss://default:...@...upstash.io:6379
REDIS_URL="rediss://default:YOUR_UPSTASH_TOKEN@YOUR_UPSTASH_HOST:6379"
# strict prevents one space from being split across multiple mediasoup instances.
# Use warn only while debugging sticky routing.
SFU_SPACE_AFFINITY="strict"
# Optional when every SFU instance has its own routable websocket URL. Wrong-node joins can redirect here.
SFU_PUBLIC_URL="wss://metaver-sfu-1.example.com/ws"
# AWS/media: open UDP and TCP for this RTC range in the EC2 security group.
# Use the EC2 public IPv4 or Elastic IP here; do not use 127.0.0.1 in production.
MEDIASOUP_LISTEN_IP="0.0.0.0"
MEDIASOUP_ANNOUNCED_IP="YOUR_EC2_PUBLIC_IPV4"
MEDIASOUP_RTC_MIN_PORT="40000"
MEDIASOUP_RTC_MAX_PORT="49999"

# Frontend (Vite injects VITE_APP_* at build time)
VITE_APP_API_URL="http://localhost:3000/api/v1"
# For scalable routing, proxy this path as /ws and hash/stick by query param spaceId.
VITE_APP_WS_URL="ws://localhost:3001"
